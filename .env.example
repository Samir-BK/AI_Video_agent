# Optional. Without a key the pipeline runs on instant mock data (never fails on stage).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Or use Groq instead of OpenAI.
# Note: Groq retired llama-3.3-70b-versatile on 16 Aug 2026.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Base URL used to build the personalized video landing link in the CEO email.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Outreach pitch sender. Dry run delivers only to OUTREACH_TEST_EMAIL.
# GMAIL_APP_PASSWORD is a Google app password for OUTREACH_SENDER_EMAIL:
# https://myaccount.google.com/apppasswords
OUTREACH_SENDER_NAME=
OUTREACH_SENDER_EMAIL=
OUTREACH_DRY_RUN=true
OUTREACH_TEST_EMAIL=
GMAIL_APP_PASSWORD=

# Booking button opens this Velho Ops calendar. Company and domain are added as query params.
NEXT_PUBLIC_BOOKING_URL=https://ops.velho.io/book/patrik/intro
